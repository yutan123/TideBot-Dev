{
  "apiVersion": 1,
  "id": "yutan123.modular_web",
  "name": "模块化网页示例",
  "version": "1.0.0",
  "author": "yutan123",
  "description": "独立模块、JSON资源与网页交互示例。",
  "entry": "main.js",
  "entryFormat": "commonjs",
  "modules": [
    "tools/lookup.js",
    "services/messages.js"
  ],
  "resources": [
    "resources/messages.json"
  ],
  "ui": {
    "type": "web",
    "entry": "web/index.html"
  },
  "tools": [
    {
      "name": "lookup",
      "description": "按关键词读取示例词库",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    }
  ]
}